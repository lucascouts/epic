{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(.epic/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-validate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.epic/archive/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-archive-guard.sh\""
          },
          {
            "type": "command",
            "if": "Write(.epic/archive/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-archive-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-executor-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.epic/stories/**/tasks.md)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-executor-guard.sh\""
          },
          {
            "type": "command",
            "if": "Write(.epic/stories/**/tasks.md)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-executor-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-commit-identity-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-session-restore.sh\""
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-orphan-drafts.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(epic:)?(validator|auditor)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-report-guard.sh\""
          }
        ]
      }
    ]
  }
}
